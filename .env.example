# KrishiNetra local development (E-00-S06). Copy to .env — never commit secrets.
DATABASE_URL=postgresql://krishinetra:krishinetra@127.0.0.1:5432/krishinetra
REDIS_URL=redis://127.0.0.1:6379/0
# Redis MI snapshot TTL in seconds (default 48h = 172800)
MI_CACHE_TTL_SECONDS=172800
LOG_LEVEL=INFO
# OGD India API key — Agmarknet mandi resource 9ef84268-d588-465a-a308-a864a43d0070
# Onboarding (ops; never commit a real key):
#   1. Create account at https://www.data.gov.in
#   2. My Account → generate API key (see https://www.data.gov.in/help)
#   3. Copy key into .env as OGD_API_KEY (staging/prod use separate keys)
#   4. Live belt backfill: DATABASE_URL=... uv run python scripts/agmarknet_backfill.py --scope belt --months 36
#   5. Refresh stats: uv run python scripts/agmarknet_backfill.py --stats --write-report --scope belt
# Demo/public keys return "Key not authorised" — not valid for national cotton backfill.
# Runbook: docs/research/AGMARKNET_PRODUCTION_ONBOARDING.md
OGD_API_KEY=your-registered-ogd-api-key-here
